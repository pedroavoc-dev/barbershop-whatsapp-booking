# Copy to .env and adjust. .env is never committed.
PORT=8090
SHOP_NAME=Magic Scissors
TIME_ZONE=Europe/Dublin

# simulator = everything stays local (demo); cloud = Meta WhatsApp Cloud API
WHATSAPP_MODE=simulator
# DEMO=1 enables the dashboard "time machine" (never with cloud)
DEMO=1

# Reminders
DAILY_SUMMARY_AT=09:30
CUSTOMER_REMINDER_MIN=60
BARBER_REMINDER_MIN=30

# Booking rules
SLOT_STEP_MIN=15
MIN_NOTICE_MIN=30
BOOKING_DAYS_AHEAD=14
MAX_ACTIVE_PER_CUSTOMER=3

# Only for WHATSAPP_MODE=cloud
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_TEMPLATE_LANG=en
WA_API_VERSION=v21.0
